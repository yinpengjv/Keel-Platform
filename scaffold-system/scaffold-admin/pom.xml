<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scaffold</groupId>
        <artifactId>scaffold-system-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-admin</artifactId>
    <name>scaffold-admin</name>

    <dependencies>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-generator</artifactId>
        </dependency>
        <!-- knife4j 4.5.0 传递的 springdoc 2.3.0 与 Spring Boot 3.5（Spring 6.2）不兼容，
             会抛 NoSuchMethodError: ControllerAdviceBean.<init>(Object)。显式升级到 2.8.x 修复，
             同时保留 knife4j 的 /doc.html 增强界面。升级时保持两者版本兼容（knife4j 4.5 兼容 springdoc 2.8）。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 单一版本源：把项目根的 VERSION 文件打进 classpath（classpath:/keel/VERSION），
                 供 /api/health 回显应用版本，与前端界面、镜像 tag 同源。 -->
            <resource>
                <directory>${project.basedir}/../..</directory>
                <includes>
                    <include>VERSION</include>
                </includes>
                <targetPath>keel</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
