# ============================================================
# 环境变量模板：复制为 .env 后按需修改（.env 不入版本库）
#   cp .env.example .env
# KEEL_IMAGE 的版本号与项目根 VERSION 文件保持一致
# ============================================================

# 应用镜像与版本
KEEL_IMAGE=keel/keel-admin:1.1.0

# 数据库
DB_PORT=3306
DB_NAME=scaffold_system
DB_USERNAME=root
DB_PASSWORD=change-me

# 应用
KEEL_PORT=8080
JWT_SECRET=please-generate-a-random-32-byte-secret
TZ=Asia/Shanghai
